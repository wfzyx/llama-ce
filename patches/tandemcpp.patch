+    const q2_dot_t f = q2_dot_select();
+    return f == q2_dot_avxvnni ? " (Q2_0 fast path: AVX-VNNI)" : f == q2_dot_avx2 ? " (Q2_0 fast path: AVX2)" : "";
+#else
+    return "";
+#endif
+}
