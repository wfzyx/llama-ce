+            // host experts not in VRAM: 32 GB 16.5 -> 23.6 tok/s with 1 predicted expert; 64 GB under 10 faults per second, off)
+            size_t host = 0;
+            for (const device & d : devices) {
+                host += d.host_bytes;
+            }
