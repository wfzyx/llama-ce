+            }
+            std::string l;
+            ok = f && std::getline(f, l) && !l.empty();
+            cores.insert(l);
+        }
+        if (ok && !cores.empty()) {
+            return (int) cores.size();
+        }
+    }
+#endif
+    return std::max(1, (int) std::thread::hardware_concurrency()/2);
