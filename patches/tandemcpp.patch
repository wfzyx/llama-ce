+static int moe_physical_cores() {
+#ifdef __linux__
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    if (sched_getaffinity(0, sizeof(set), &set) == 0) {
+        std::set<std::string> cores;
+        bool ok = true;
+        for (int c = 0; c < CPU_SETSIZE && ok; ++c) {
