+                    // hybrid mode: the zero slot (index n_slots) is part of the view
+                    ggml_tensor * cached = ggml_view_3d(bctx, bank, bank->ne[0], bank->ne[1], g.n_slots + (hybrid ? 1 : 0), bank->nb[1], bank->nb[2], 0);
