+        rb_x   = ggml_new_tensor_1d(ctx_host.get(), GGML_TYPE_F32, max_batch*model.hparams.n_embd);
+        rb_w   = ggml_new_tensor_1d(ctx_host.get(), GGML_TYPE_F32, max_batch*64);
