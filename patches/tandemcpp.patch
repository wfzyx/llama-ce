+        }
+        graph_pool.resize(k);
+    }
+    graph_pool_main(); // a reserve after the reset must use the main scheduler
+    for (auto & e : graph_pool) {
+        if (e.res) {
+            e.res->reset();
+        }
+        if (e.sched) {
+            ggml_backend_sched_reset(e.sched.get());
+        }
+        e.active = false;
+    }
